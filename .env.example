# Server-side only. Never prefix secrets with VITE_.
GEMINI_API_KEY=
# Hosted production requires a durable PostgreSQL database (including Vercel).
# Configure SSL according to your database provider; do not disable certificate verification.
DATABASE_URL=
# Exact public origin, with no trailing slash. Required in production.
APP_ORIGIN=https://your-app.example
# Self-hosting without DATABASE_URL uses SQLite here. Mount a persistent private volume.
DATA_DIR=./data
PORT=3000
