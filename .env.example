# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this in Vercel Environment Variables (not committed).
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Admin password for the Admin@kmh account.
# Set this ONLY in Vercel Environment Variables so it is not public.
# VITE_ prefix makes it available to the frontend build.
VITE_ADMIN_PASSWORD="SET_A_STRONG_PASSWORD_ONLY_IN_VERCEL"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://plagiarismcheckerandaidectector.vercel.app/"

# RESEND_API_KEY: Resend API key for sending verification emails.
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Optional custom sender address (defaults to VeritasAI <onboarding@resend.dev>).
RESEND_FROM_EMAIL=""
