# Server-side only. Never prefix secrets with VITE_.
GEMINI_API_KEY=
# Optional direct Gemini model. Flash-Lite supports JSON and Search grounding.
# Current Gemini 3.x web search requires paid-tier availability in the project.
GEMINI_MODEL=gemini-3.5-flash-lite
# Hosted production requires a durable PostgreSQL database (including Vercel).
# Configure SSL according to your database provider; do not disable certificate verification.
DATABASE_URL=
# Exact public origin, with no trailing slash. Required in production.
APP_ORIGIN=https://your-app.example
# Self-hosting without DATABASE_URL uses SQLite here. Mount a persistent private volume.
DATA_DIR=./data
PORT=3000

# Managed email-code verification service (server-only).
NEON_AUTH_BASE_URL=
# Optional: Vercel deployments use their own OIDC token automatically.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
# Optional read-only owner dashboard. Exact verified account ID from this database.
# Keep server-only; blank disables admin access. No separate admin password.
OWNER_ACCOUNT_ID=
